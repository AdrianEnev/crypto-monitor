# Copy this file to .env and choose your own positive delays, in days.
# Fractional days are accepted; blank values and zero stop startup.
PWLH_delay=
PMLH_delay=
PQLH_delay=

# Explicit, editable notification and terminal timings, in seconds.
NOTIFICATION_MAX_AGE_SECONDS=60
EMAIL_RETRY_SECONDS=30
FRESH_HIGHLIGHT_SECONDS=60
